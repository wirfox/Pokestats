{
  "name": "pokestats",
  "version": "1.0.0",
  "description": "Analyseur d'équipe Pokémon Écarlate / Violet — outil fan non officiel, 100 % côté client.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node test/engine.test.js",
    "build:data": "node scripts/build-data.mjs --all",
    "build:tiers": "node scripts/build-data.mjs --tiers",
    "build:names": "node scripts/build-data.mjs --names",
    "serve": "npx --yes http-server . -p 8080 -c-1",
    "verify:data": "node scripts/verify-data.mjs",
    "build:types": "node scripts/build-data.mjs --types",
    "build:game8": "node scripts/fetch-game8.mjs",
    "build:moves": "node scripts/build-data.mjs --moves",
    "build:gens": "node scripts/build-data.mjs --gens",
    "build:games": "node scripts/build-data.mjs --games",
    "build:pokedex": "node scripts/build-data.mjs --pokedex",
    "build:forms": "node scripts/build-data.mjs --forms",
    "test:mobile": "node test/mobile.test.mjs"
  },
  "keywords": [
    "pokemon",
    "pokeapi",
    "tier-list",
    "scarlet-violet",
    "fan-tool"
  ],
  "license": "MIT",
  "devDependencies": {
    "@pkmn/data": "0.10.11",
    "@pkmn/dex": "0.10.11",
    "pokemon": "3.3.1"
  }
}
